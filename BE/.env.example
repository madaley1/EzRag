# Directories to ingest (comma-separated, mounted via Docker volumes)
RAG_DIRS=/data

# ChromaDB connection (matches docker-compose service name)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=ezrag

# Ollama (local LLM via docker-compose model service)
MODEL_BASE_URL=http://model:11434
OLLAMA_MODEL=llama3.2

# Optional: set to use OpenAI instead of Ollama
OPENAI_API_KEY=

# Local HuggingFace model (takes priority over Ollama/OpenAI when set).
# Requires: pip install -r requirements-local-llm.txt
# The model is loaded in bf16 — ensure you have enough RAM/VRAM (~104 GB for Qwen3-32B).
# On Apple Silicon: LOCAL_MODEL_DEVICE=mps (or auto)
# On NVIDIA GPU:    LOCAL_MODEL_DEVICE=auto  (picks CUDA automatically)
# On CPU only:      LOCAL_MODEL_DEVICE=cpu   (very slow for 32B)
LOCAL_MODEL_PATH=
LOCAL_MODEL_DEVICE=auto
LOCAL_MODEL_MAX_NEW_TOKENS=1024

# Embedding model (downloaded automatically from HuggingFace on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
QUERY_N_RESULTS=5
